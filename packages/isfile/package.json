{
  "name": "@aibulat/isfile",
  "version": "0.0.4",
  "description": "check if file exists",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --import ./test/register.ts --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepack": "pnpm run build"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "file",
    "exists",
    "fs",
    "isfile",
    "is-file",
    "check file"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ngmaibulat/packages.git",
    "directory": "packages/isfile"
  },
  "bugs": {
    "url": "https://github.com/ngmaibulat/packages/issues"
  },
  "homepage": "https://github.com/ngmaibulat/packages/tree/main/packages/isfile#readme",
  "author": "Aibulat",
  "license": "MIT",
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@types/node": "^22.13.1",
    "publint": "^0.3.23",
    "tsdown": "^0.22.14",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
