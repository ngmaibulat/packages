{
  "compilerOptions": {
    /* Language and Environment */
    "target": "ES2022",

    /* Modules */
    "module": "ESNext",
    "rootDir": "./src",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,

    /* Emit */
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "outDir": "./dist",
    "removeComments": true,

    /* Interop Constraints */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    /* Type Checking */
    "strict": true,
    "skipLibCheck": true,

    /* Pinned rather than left to inference: an unset value walks up and takes
       whichever @types/node it finds first, which in a workspace with several
       majors in it is not necessarily this package's own ^26. */
    "types": ["node"],

    /* Path aliases, resolved by tsdown at build time and by test/register.ts
       under `node --test`. */
    "paths": {
      "@/*": ["./src/*"],
      "$/*": ["./*"]
    }
  },

  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
