{
  "name": "mk-swagger-ui",
  "version": "1.0.9",
  "description": "Static API reference generator (Scalar UI) from an OpenAPI YAML document",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "mk-swagger-ui": "dist/index.js"
  },
  "scripts": {
    "test": "node --import ./test/register.ts --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepack": "pnpm run build"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "OpenAPI",
    "Swagger",
    "Scalar",
    "API",
    "API Docs",
    "REST API",
    "API Reference"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ngmaibulat/packages.git",
    "directory": "packages/mk-swagger-ui"
  },
  "bugs": {
    "url": "https://github.com/ngmaibulat/packages/issues"
  },
  "homepage": "https://github.com/ngmaibulat/packages/tree/main/packages/mk-swagger-ui#readme",
  "author": "Aibulat",
  "license": "MIT",
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@types/node": "^22.13.1",
    "publint": "^0.3.23",
    "tsdown": "^0.22.14",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@scalar/api-reference": "^1.64.1",
    "commander": "^10.0.0",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
