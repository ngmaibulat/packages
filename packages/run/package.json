{
  "name": "@aibulat/run",
  "version": "0.2.26",
  "description": "Run a program with env vars specified",
  "main": "./dist/lib.js",
  "types": "./dist/lib.d.ts",
  "bin": {
    "run": "dist/cli/run.js",
    "logview": "dist/cli/logview.js",
    "output": "dist/cli/output.js",
    "shell": "dist/cli/shell.js"
  },
  "type": "module",
  "scripts": {
    "test": "node --import ./test/register.ts --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepack": "pnpm run build"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "run",
    "exec",
    "execute",
    "spawn",
    "process",
    "subprocess",
    "child process"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ngmaibulat/packages.git"
  },
  "bugs": {
    "url": "https://github.com/ngmaibulat/packages/issues"
  },
  "homepage": "https://github.com/ngmaibulat/packages/tree/main/packages/run#readme",
  "author": "Aibulat",
  "license": "MIT",
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@types/bun": "^1.2.2",
    "@types/node": "^22.13.1",
    "publint": "^0.3.23",
    "tsdown": "^0.22.14",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.1.0",
    "chokidar": "^4.0.3",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
