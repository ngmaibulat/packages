{
    "name": "@aibulat/indexeddb-impl",
    "version": "0.1.1",
    "description": "A pure JavaScript in-memory implementation of IndexedDB, for tests that must not need a browser",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./types.d.ts",
    "exports": {
        ".": {
            "types": "./types.d.ts",
            "default": "./dist/index.js"
        },
        "./auto": {
            "types": "./auto.d.ts",
            "default": "./dist/auto.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch",
        "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
        "test": "node --test \"test/**/*.test.ts\"",
        "test:bun": "bun test test/",
        "test:wpt": "node --test test/wpt.test.ts",
        "prepack": "pnpm run build"
    },
    "files": [
        "dist",
        "src",
        "types.d.ts",
        "auto.d.ts",
        "NOTICE",
        "CHANGELOG.md"
    ],
    "publishConfig": {
        "access": "public"
    },
    "keywords": [
        "indexeddb",
        "idb",
        "in-memory",
        "polyfill",
        "shim",
        "testing",
        "database",
        "ESM",
        "TypeScript"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ngmaibulat/packages.git",
        "directory": "packages/indexeddb-impl"
    },
    "bugs": {
        "url": "https://github.com/ngmaibulat/packages/issues"
    },
    "homepage": "https://github.com/ngmaibulat/packages/tree/main/packages/indexeddb-impl#readme",
    "author": "Aibulat",
    "license": "Apache-2.0",
    "devDependencies": {
        "@arethetypeswrong/core": "^0.18.5",
        "@types/node": "^26.0.0",
        "dexie": "^4.0.11",
        "glob": "^11.0.2",
        "publint": "^0.3.23",
        "smol-toml": "^1.4.1",
        "tsdown": "^0.22.14",
        "typescript": "^5.9.3"
    },
    "engines": {
        "node": ">=26",
        "bun": ">=1.3"
    }
}
