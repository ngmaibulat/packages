{
	"name": "@aibulat/svelte-admin-kit",
	"version": "0.2.0",
	"description": "Reusable Svelte 5 admin-UI primitives — controls, layout, feedback, data display, overlays, icon registry, Monaco and tiptap editors.",
	"license": "MIT",
	"author": "Aibulat",
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./icon": {
			"types": "./dist/icon/index.d.ts",
			"svelte": "./dist/icon/index.js",
			"default": "./dist/icon/index.js"
		},
		"./editor": {
			"types": "./dist/editor/index.d.ts",
			"svelte": "./dist/editor/index.js",
			"default": "./dist/editor/index.js"
		},
		"./editor/format-markdown-tables": {
			"types": "./dist/editor/formatMarkdownTables.d.ts",
			"default": "./dist/editor/formatMarkdownTables.js"
		},
		"./controls": {
			"types": "./dist/controls/index.d.ts",
			"svelte": "./dist/controls/index.js",
			"default": "./dist/controls/index.js"
		},
		"./layout": {
			"types": "./dist/layout/index.d.ts",
			"svelte": "./dist/layout/index.js",
			"default": "./dist/layout/index.js"
		},
		"./feedback": {
			"types": "./dist/feedback/index.d.ts",
			"svelte": "./dist/feedback/index.js",
			"default": "./dist/feedback/index.js"
		},
		"./data": {
			"types": "./dist/data/index.d.ts",
			"svelte": "./dist/data/index.js",
			"default": "./dist/data/index.js"
		},
		"./overlay": {
			"types": "./dist/overlay/index.d.ts",
			"svelte": "./dist/overlay/index.js",
			"default": "./dist/overlay/index.js"
		},
		"./richtext": {
			"types": "./dist/richtext/index.d.ts",
			"default": "./dist/richtext/index.js"
		},
		"./richtext/labels": {
			"types": "./dist/richtext/labels.d.ts",
			"default": "./dist/richtext/labels.js"
		},
		"./richtext-editor": {
			"types": "./dist/richtext/editor-index.d.ts",
			"svelte": "./dist/richtext/editor-index.js",
			"default": "./dist/richtext/editor-index.js"
		},
		"./richtext/content.css": "./dist/richtext/content.css",
		"./styles/theme.css": "./dist/styles/theme.css",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "svelte-package && publint",
		"dev": "svelte-package --watch",
		"typecheck": "svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepack": "pnpm run build"
	},
	"peerDependencies": {
		"monaco-editor": "^0.55.0",
		"svelte": "^5.0.0"
	},
	"peerDependenciesMeta": {
		"monaco-editor": {
			"optional": true
		}
	},
	"dependencies": {
		"@tiptap/core": "3.27.3",
		"@tiptap/extension-details": "3.27.3",
		"@tiptap/extension-emoji": "3.27.3",
		"@tiptap/extension-image": "3.27.3",
		"@tiptap/extension-list": "3.27.3",
		"@tiptap/extension-mention": "3.27.3",
		"@tiptap/extension-table": "3.27.3",
		"@tiptap/extensions": "3.27.3",
		"@tiptap/pm": "3.27.3",
		"@tiptap/starter-kit": "3.27.3",
		"@tiptap/suggestion": "3.27.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"monaco-editor": "^0.55.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"publint": "^0.3.23",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.9"
	},
	"keywords": [
		"svelte",
		"svelte5",
		"components",
		"ui",
		"admin",
		"runes",
		"monaco",
		"tiptap",
		"design-system"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ngmaibulat/packages.git",
		"directory": "packages/svelte-admin-kit"
	},
	"bugs": {
		"url": "https://github.com/ngmaibulat/packages/issues"
	},
	"homepage": "https://github.com/ngmaibulat/packages/tree/main/packages/svelte-admin-kit#readme",
	"engines": {
		"node": ">=22.12"
	}
}
