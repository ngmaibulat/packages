{
  "name": "@aibulat/fs",
  "version": "0.0.7",
  "description": "FS utilities",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "fs": "dist/bin/fs.js"
  },
  "scripts": {
    "test": "node --import ./test/register.ts --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepack": "pnpm run build"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "fs",
    "filesystem",
    "ls",
    "hash",
    "file type"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ngmaibulat/packages.git",
    "directory": "packages/fs"
  },
  "bugs": {
    "url": "https://github.com/ngmaibulat/packages/issues"
  },
  "homepage": "https://github.com/ngmaibulat/packages/tree/main/packages/fs#readme",
  "author": "Aibulat",
  "license": "MIT",
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@types/node": "^22.13.1",
    "@types/posix": "^4.2.0",
    "publint": "^0.3.23",
    "tsdown": "^0.22.14",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@aibulat/isfile": "^0.0.4",
    "@colors/colors": "^1.5.0",
    "@npcz/magic": "^1.3.14",
    "cli-table3": "^0.6.3",
    "commander": "^10.0.0",
    "passwd-user": "^4.0.0",
    "posix": "^4.2.0"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
