{
  "name": "@aibulat/naser",
  "version": "0.0.7",
  "description": "Ansi to HTML converter",
  "main": "./dist/index.js",
  "types": "./dist/lib.d.ts",
  "bin": {
    "naser": "dist/index.js"
  },
  "type": "module",
  "scripts": {
    "test": "node --import ./test/register.ts --test \"test/**/*.test.ts\"",
